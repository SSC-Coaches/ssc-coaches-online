# Vorlage – nur Platzhalter. Echte Werte in Vercel (Settings → Environment Variables)
# oder lokal in einer nicht eingecheckten .env.local eintragen.
# Supabase: Project Settings → API (Project URL und anon/publishable key).
# Niemals den service_role / secret key verwenden.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
